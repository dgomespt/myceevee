# The id of the gist holding your JSON Resume files: the long hash in its address,
# https://gist.github.com/<you>/<THIS-PART>. The full gist URL works too.
GIST_ID=
GIST_FILE_FULL=resume.json
GIST_FILE_ONEPAGE=resume.onepage.json
# Optional: raises the GitHub API rate limit (needs no scopes for public gists)
GITHUB_TOKEN=

# Owner login for /admin, and the key used to sign the session cookie.
# Both are REQUIRED to be strong: ADMIN_TOKEN at least 12 characters, SESSION_SECRET at least 32, and not the
# placeholders below (the admin area stays locked until you replace them). `make setup` generates them for you,
# or: openssl rand -hex 16   (token)   /   openssl rand -base64 32   (secret)
ADMIN_TOKEN=change-me
SESSION_SECRET=change-me-to-a-long-random-string

# Origin used to build short-link URLs, no trailing slash
PUBLIC_BASE_URL=http://localhost:4321
DATABASE_PATH=./data/myceevee.db

# Optional: override for tests or GitHub Enterprise
# GITHUB_API_URL=https://api.github.com
# Set to 1 when behind your own reverse proxy so X-Forwarded-For is used for rate limiting
# TRUST_PROXY=1
# Which sections each CV shows, in this order, with optional "most recent N" limits.
# Names: summary, work (alias: experience), projects, education, skills, volunteer, certificates, awards,
# publications, languages, interests, references.
# Options go after the name, separated by colons, in any order:
#   work:3          the 3 most recent entries by date
#   work:summary    each position shows its summary text only, no bullet highlights (work, volunteer, projects)
#   work:3:summary  both
#
# ONEPAGE_SECTIONS builds the one-page CV from resume.json. It is only used when the gist has NO
# resume.onepage.json (if that file exists it is shown as-is). Leave it empty/removed and a missing
# one-page file is simply an error: nothing is derived unless you ask for it here.
ONEPAGE_SECTIONS=summary, work:3:summary, projects:2:summary, education, skills, languages
# FULL_SECTIONS trims the full CV the same way. Unset = show everything in resume.json.
# FULL_SECTIONS=

# Where the homepage (/) sends visitors when NO CV is public, e.g. your LinkedIn or personal site (http/https only).
# Leave it out to show a small landing page instead. Expired short links never redirect: they show that landing
# page (your name from the CV, plus "Reach me at" web / GitHub / LinkedIn; never email, phone or address).
# HOME_REDIRECT_URL=https://www.linkedin.com/in/your-name

# How long the gist and the Gravatar photo are cached before being re-fetched.
# Format: 90s, 30m, 6h, 2d (a bare number means seconds; range 1s to 30d).
# The cache lives in memory, so a restart clears it. "Refresh from gist" in /admin clears it on demand.
# GIST_CACHE_TTL=1h
# AVATAR_CACHE_TTL=1d

# Optional: override the Gravatar host (tests)
# GRAVATAR_BASE_URL=https://gravatar.com
